{{!
    @template mod_probability/main

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod_probability-shell" data-region="probability-simulator">
    <h3>{{#str}}chooseexperiment, mod_probability{{/str}}</h3>
    <div class="mod_probability-modes" role="group" aria-label="{{#str}}chooseexperiment, mod_probability{{/str}}">
        {{#coin}}
            <button type="button" class="mod_probability-mode" data-mode="coin" aria-pressed="{{#coinactive}}true{{/coinactive}}{{^coinactive}}false{{/coinactive}}">
                {{#str}}coin, mod_probability{{/str}}
            </button>
        {{/coin}}
        {{#die}}
            <button type="button" class="mod_probability-mode" data-mode="die" aria-pressed="{{#dieactive}}true{{/dieactive}}{{^dieactive}}false{{/dieactive}}">
                {{#str}}die, mod_probability{{/str}}
            </button>
        {{/die}}
        {{#urn}}
            <button type="button" class="mod_probability-mode" data-mode="urn" aria-pressed="{{#urnactive}}true{{/urnactive}}{{^urnactive}}false{{/urnactive}}">
                {{#str}}urn, mod_probability{{/str}}
            </button>
        {{/urn}}
    </div>

    <div class="mod_probability-panel">
        <div data-config="coin" {{^coinactive}}hidden{{/coinactive}}>
            <div class="mod_probability-config-grid">
                <div>
                    <label class="form-label" for="mod_probability_coin_probability">{{#str}}coinprobability, mod_probability{{/str}}</label>
                    <input id="mod_probability_coin_probability" class="form-control" type="number" min="0" max="100" step="0.1" value="50" data-input="coin-probability">
                </div>
            </div>
        </div>

        <div data-config="die" {{^dieactive}}hidden{{/dieactive}}>
            <div class="mod_probability-config-grid">
                <div>
                    <label class="form-label" for="mod_probability_die_sides">{{#str}}diesides, mod_probability{{/str}}</label>
                    <input id="mod_probability_die_sides" class="form-control" type="number" min="2" max="100" step="1" value="6" data-input="die-sides">
                </div>
            </div>
        </div>

        <div data-config="urn" {{^urnactive}}hidden{{/urnactive}}>
            <div>
                <label class="form-label" for="mod_probability_urn_contents">{{#str}}urncontents, mod_probability{{/str}}</label>
                <textarea id="mod_probability_urn_contents" class="form-control" rows="5" data-input="urn-contents" placeholder="{{#str}}urnexample, mod_probability{{/str}}">{{#str}}urnexample, mod_probability{{/str}}</textarea>
                <div class="form-text">{{#str}}urnhelp, mod_probability{{/str}}</div>
            </div>
        </div>

        <hr>
        <h4>{{#str}}simulations, mod_probability{{/str}}</h4>
        <div class="mod_probability-trials" role="group" aria-label="{{#str}}simulations, mod_probability{{/str}}">
            <button type="button" class="mod_probability-trial" data-trials="10" aria-pressed="{{#trial10}}true{{/trial10}}{{^trial10}}false{{/trial10}}">10</button>
            <button type="button" class="mod_probability-trial" data-trials="100" aria-pressed="{{#trial100}}true{{/trial100}}{{^trial100}}false{{/trial100}}">100</button>
            <button type="button" class="mod_probability-trial" data-trials="1000" aria-pressed="{{#trial1000}}true{{/trial1000}}{{^trial1000}}false{{/trial1000}}">1.000</button>
        </div>

        <div class="mt-3">
            <button type="button" class="btn btn-primary mod_probability-run" data-action="run">{{#str}}run, mod_probability{{/str}}</button>
        </div>

        <div class="alert alert-danger mt-3" data-region="error" role="alert" hidden></div>
        <div class="mod_probability-results" data-region="results" hidden></div>
    </div>
</div>
