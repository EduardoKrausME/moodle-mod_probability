{{!
    @template mod_probability/results

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<h3>{{#str}}results, mod_probability{{/str}}</h3>
<div class="mod_probability-summary">
    <div class="mod_probability-stat">
        <span>{{#str}}trials, mod_probability{{/str}}</span>
        <strong>{{trials}}</strong>
    </div>
    <div class="mod_probability-stat">
        <span>{{#str}}outcomes, mod_probability{{/str}}</span>
        <strong>{{outcomecount}}</strong>
    </div>
    <div class="mod_probability-stat">
        <span>{{#str}}largesterror, mod_probability{{/str}}</span>
        <strong>{{largesterror}} pp</strong>
    </div>
</div>

<div class="mod_probability-bars">
    {{#rows}}
        <div class="mod_probability-bar-row">
            <strong>{{label}}</strong>
            <div class="mod_probability-bar-track" aria-hidden="true">
                <div class="mod_probability-bar-observed" style="width: {{observed}}%;"></div>
                <div class="mod_probability-bar-theoretical" style="left: {{theoretical}}%;"></div>
            </div>
            <span>{{observedformatted}}%</span>
        </div>
    {{/rows}}
</div>
<p class="mod_probability-note mt-2">{{#str}}theorymarker, mod_probability{{/str}}</p>

<div class="table-responsive mod_probability-table">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>{{#str}}outcome, mod_probability{{/str}}</th>
                <th>{{#str}}observedcount, mod_probability{{/str}}</th>
                <th>{{#str}}observedfrequency, mod_probability{{/str}}</th>
                <th>{{#str}}theoreticalprobability, mod_probability{{/str}}</th>
                <th>{{#str}}difference, mod_probability{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <td>{{label}}</td>
                    <td>{{count}}</td>
                    <td>{{observedformatted}}%</td>
                    <td>{{theoreticalformatted}}%</td>
                    <td>{{differenceformatted}} pp</td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>

{{#sequence}}
    <h4>{{#str}}firstoutcomes, mod_probability{{/str}}</h4>
    <div class="mod_probability-sequence">
        {{#sequence}}
            <span class="mod_probability-token">{{.}}</span>
        {{/sequence}}
    </div>
{{/sequence}}
